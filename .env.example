# =============================================================================
# GeoRepute — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials.
#
# Everything here is OPTIONAL. With none of it set the site builds, deploys
# and runs — pricing stays hidden, and the booking panel shows its fallback
# instead of a calendar. Nothing throws.
# =============================================================================


# -----------------------------------------------------------------------------
# BOOKING — Cal.com (requirements doc §5)
# -----------------------------------------------------------------------------
# Cal.com holds the calendar: real availability, double-booking prevention, and
# the confirmation emails to both the visitor and the host. We own the UI, so
# the experience stays native to the site.
#
# SETUP
#   1. Create an account at cal.com (the free tier covers this).
#   2. Connect your real Google or Outlook calendar. This is the step that
#      makes availability real — anything already in your calendar becomes
#      unbookable automatically.
#   3. Create an event type ("Executive Briefing", 45 minutes to match the
#      site copy). Set its minimum notice to 48 hours so Cal.com's own
#      booking page agrees with ours; the site enforces this independently.
#   4. API key: Settings → Developer → API keys. Shown once — copy it.
#   5. Event type ID: open the event type for editing; it is the number in
#      the URL.
#
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, deliberately — this key must never be
# inlined into a browser bundle. It is read only inside app/api/booking/.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Cal.com pins breaking changes to dated version headers, and the two
# endpoints we use are on different dates. Override only if Cal.com deprecates
# one — see lib/booking/config.ts.
# CAL_SLOTS_API_VERSION=2024-09-04
# CAL_BOOKINGS_API_VERSION=2024-08-13
# CAL_API_BASE=https://api.cal.com/v2


# -----------------------------------------------------------------------------
# PRICING (requirements doc §4 and §7)
# -----------------------------------------------------------------------------
# Public pricing is withheld until the final structure is supplied. The code is
# intact, not deleted — this flag is the whole switch.
#
#   unset / false  →  /pricing, /checkout 404. No price renders anywhere.
#                     Buy controls become "Book an Intelligence Briefing".
#   true           →  the entire pricing surface returns.
#
# Inlined at BUILD time, so changing it requires a rebuild, not a restart.
# NEXT_PUBLIC_SHOW_PRICING=false


# -----------------------------------------------------------------------------
# ANALYTICS (requirements doc §6)
# -----------------------------------------------------------------------------
# Not yet wired — no provider has been chosen. Add the key here once one is,
# and see docs/PRE-LAUNCH.md for where it gets loaded.
# NEXT_PUBLIC_ANALYTICS_ID=
